PORT=
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# CONFIGURATION JWT (Validité 1 semaine / 7 jours)
JWT_SECRET=
JWT_EXPIRES_IN=

# CONFIGURATION DU SERVICE EMAIL (SMTP)
# En production, renseignez vos identifiants SMTP (ex: Gmail, Brevo, Sendgrid, Mailtrap)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# CONFIGURATION DE L'URL PUBLIQUE (IP ou Nom de Domaine)
# Utilisée pour construire les liens d'activation et de mot de passe valables 1 mois
APP_URL=

# Google OAuth2 - Identifiants à obtenir depuis Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# JWT sécurisé pour les liens d'activation (30 jours)
# Minimum 32 caractères - À changer pour une clé unique
JWT_SECURE_SECRET=

# CONFIGURATION WHATSAPP CLOUD API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=